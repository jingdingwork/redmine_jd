<div class="contextual">
<%= link_to sprite_icon('add', l(:label_issue_custom_field_scheme_new)), new_issue_custom_field_scheme_path, :class => 'icon icon-add' %>
</div>

<h2><%= l(:label_issue_custom_field_scheme_plural) %></h2>

<% if @schemes.any? %>
<table class="list issue-custom-field-schemes">
  <thead>
    <tr>
      <th><%= l(:field_name) %></th>
      <th><%= l(:field_description) %></th>
      <th><%= l(:label_custom_field_plural) %></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
  <% @schemes.each do |scheme| %>
    <tr>
      <td class="name"><%= link_to scheme.name, edit_issue_custom_field_scheme_path(scheme) %></td>
      <td class="description"><%= scheme.description %></td>
      <td><%= scheme.issue_custom_fields.map {|field| custom_field_name_tag(field)}.join(', ').html_safe %></td>
      <td class="buttons">
        <%= reorder_handle(scheme, :url => issue_custom_field_scheme_path(scheme), :param => 'issue_custom_field_scheme') %>
        <%= link_to sprite_icon('copy', l(:button_copy)), new_issue_custom_field_scheme_path(:copy => scheme), :class => 'icon icon-copy' %>
        <%= delete_link issue_custom_field_scheme_path(scheme) %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
<% else %>
<p class="nodata"><%= l(:label_no_data) %></p>
<% end %>

<% html_title(l(:label_issue_custom_field_scheme_plural)) -%>

<%= javascript_tag do %>
  $(function() { $("table.issue-custom-field-schemes tbody").positionedItems(); });
<% end %>
